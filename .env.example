# Copy to .env on the backend machine. Never commit .env.
DATABASE_PATH=data/dispatch.sqlite3
EXTERNAL_API_TIMEOUT_SECONDS=8
# Read-only connectors. Enable only after enterprise authorization.
# API_URL is a complete approved JSON GET endpoint. No URL is accepted from UI.
# AUTH_MODE: bearer | api_key (X-API-Key) | none (only if approved).
TMS_READ_ENABLED=false
TMS_API_URL=
TMS_ALLOWED_HOSTS=
TMS_AUTH_MODE=bearer
TMS_API_TOKEN=
GPS_READ_ENABLED=false
GPS_API_URL=
GPS_ALLOWED_HOSTS=
GPS_AUTH_MODE=bearer
GPS_API_TOKEN=
ONP_READ_ENABLED=false
ONP_API_URL=
ONP_ALLOWED_HOSTS=
ONP_AUTH_MODE=bearer
ONP_API_TOKEN=

# Hosting only. Set production credentials as secrets in Render Environment.
APP_ENV=local
DEMO_USERNAME=
DEMO_PASSWORD=

# Optional read-only enterprise mailbox (configure only after permission)
MAIL_READ_ENABLED=false
MAIL_IMAP_HOST=
MAIL_ALLOWED_HOSTS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
# Optional AI document extraction. Sent only after explicit user confirmation.
OPENAI_API_KEY=
DOCUMENT_AI_MODEL=
